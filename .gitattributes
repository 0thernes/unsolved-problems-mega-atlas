# SPDX-License-Identifier: Apache-2.0
# Enforce deterministic LF line endings across Windows, macOS, and Linux so
# byte-exact SHA-256 manifests (CHECKSUMS.sha256, data/MANIFEST.sha256) match
# identically on every operating system and clean clone.
* text=auto eol=lf

*.png binary
*.pdf binary
*.gz binary
*.tgz binary
*.xlsx binary
*.xls binary
*.sqlite binary
*.olean binary
*.ilean binary
*.tsr binary
*.ots binary
*.c binary
*.o binary
