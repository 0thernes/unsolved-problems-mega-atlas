# Unsolved Problems Mega-Atlas (V2.4.0) — Optional Environment Configuration
# Copy to `.env` ONLY if you plan to run optional Zenodo API deposit commands
# or override tool paths. Normal offline usage requires ZERO environment variables.
# NEVER commit `.env` or real tokens to git!

# Optional: Zenodo production personal access token (used only by `scripts/publish_zenodo.py --publish`)
ZENODO_TOKEN=

# Optional: Zenodo sandbox personal access token (used only by `scripts/publish_zenodo.py --sandbox`)
ZENODO_SANDBOX_TOKEN=

# Optional: Explicit path to Tectonic binary if not on PATH (used by `scripts/build_paper.py`)
TECTONIC_BIN=
